# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4000,http://localhost:4173,http://localhost:5173

# Supabase Configuration
# Obtain these from your Supabase Project Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth via Supabase (Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client IDs)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret

# Direct PostgreSQL Connection String (Optional / Supabase Transaction or Session Pooler)
# e.g., postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Storage Buckets
SUPABASE_STORAGE_BUCKET=snapshots-vault
SUPABASE_STORAGE_PUBLIC_BUCKET=samples-public

# Ingestion & Scrapers
SCRAPER_ENABLED=true
# Default: every 6 hours. Supports standard 5-field cron syntax (node-cron).
SCRAPER_CRON=0 */6 * * *
# Random delay (0..N seconds) before a scheduled run so restarts don't all scrape at once.
SCRAPER_JITTER_SECONDS=90
# GET /health (and the admin health endpoint) flags ingestion as stale after this many hours.
SCRAPER_STALE_AFTER_HOURS=12
# MahaRERA public search terms (comma separated) and max records per run
MAHARERA_SEARCH_TERMS=Godrej,Panchshil,Kolte,Embassy
MAHARERA_MAX_RESULTS=100
# Keep only MahaRERA projects in this district (default Pune). Use "all" for state-wide.
MAHARERA_DISTRICT=Pune
# Built-in live listing feed: when DATZ_LISTING_SOURCES is empty the pipeline
# scrapes SquareYards' public Pune sale page (server-rendered HTML).
DATZ_LISTING_MAX_PAGES=2
# JSON array of configurable classifieds sources. When set, these replace the
# built-in SquareYards feed. All fields are optional except card/title/price/area/location;
# missing selectors yield null.
# [{"slug":"pune-sample","url":"https://example.com/pune-listings","dataset":"pune-real-estate-data","selectors":{"card":".card","title":".title","price":".price","area":".area","location":".location","built_up":".builtup","super_built_up":".superbuiltup","configuration":".bhk","property_type":".type","property_sub_type":".subtype","floor":".floor","total_floors":".totalfloors","facing":".facing","parking":".parking","furnishing":".furnishing","previous_price":".prevprice","construction_stage":".stage","possession_date":".possession","listed_by":".listedby","source_url":"a.detail","latitude":".lat","longitude":".lng"}}]
DATZ_LISTING_SOURCES=
# Only enable for local tests. Never enable in production; it returns fixture data.
DATZ_FIXTURE_MODE=false

# Auth & Entitlements
# Required in production: secret used to sign short-lived web session and download tokens.
DOWNLOAD_TOKEN_SECRET=
# JSON array of dev API keys: [{"name":"local","key":"replace-me","scopes":["datasets:read","downloads:read","orders:write","admin","admin:sandbox"]}]
DATZ_API_KEYS=
# Disabled by default. Enables POST /api/v1/orders/:id/confirm for sandbox testing only.
ALLOW_SANDBOX_PAYMENTS=false
# Testing only: allows an unpaid full export (POST /api/v1/downloads/export) and
# full record access through a web session. The sample export is no longer the
# only browser download. Enabled by default for local testing; set to false
# when a payment gateway is live.
ALLOW_UNPAID_FULL_ACCESS=true

# Payment Gateways (Razorpay for INR / Stripe for Global)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
